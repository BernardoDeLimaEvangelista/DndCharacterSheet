<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DndCharacterSheet.MainPage"
             BackgroundColor="#f5f4f2">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Grid Borders parte de cima da ficha, informações gerais-->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                <!--Border Nome do Personagem-->
                <Border StrokeShape="RoundRectangle 10" 
                        Padding="10" 
                        Margin="0, 0, 15, 0" 
                        BackgroundColor="White" 
                        Stroke="Black" 
                        StrokeThickness="2" 
                        HorizontalOptions="End" 
                        WidthRequest="750" 
                        Grid.Column="0" 
                        HeightRequest="80">
                    
                    <Entry Placeholder="Nome do Personagem" 
                        FontSize="30" 
                        FontAttributes="Bold" 
                        Grid.ColumnSpan="2"
                        WidthRequest="700"
                        HorizontalOptions="Start"
                        TextColor="Black"/>
                    
                </Border>

                <!--Border Informações gerais-->
                <Border StrokeShape="RoundRectangle 10" 
                        Padding="10" 
                        BackgroundColor="White" 
                        Stroke="Black" 
                        StrokeThickness="2" 
                        HorizontalOptions="End" 
                        WidthRequest="940" 
                        Grid.Column="1">
                    <!--Grid Informações gerais-->
                    <Grid ColumnDefinitions="*, *, *, *" RowDefinitions="Auto, Auto">
                    
                        <Entry Placeholder="Classe e Nível" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           Grid.ColumnSpan="2"
                           WidthRequest="275"
                           HorizontalOptions="Start"
                           TextColor="Black"
                           MaxLength="24"/>

                    
                        <Entry Placeholder="Subclasse" 
                           Grid.Row="1" 
                           Grid.Column="0"
                           FontSize="14"
                           TextColor="Black"
                           WidthRequest="200"
                           HeightRequest="10"
                           HorizontalOptions="Start"
                           FontAttributes="Bold"
                           MaxLength="20"/>

                        <Entry Placeholder="Race"
                               Grid.Row="1"
                               Grid.Column="1"
                               FontSize="18"
                               TextColor="Black"
                               WidthRequest="175"
                               HorizontalOptions="Start"
                               FontAttributes="Bold"
                               HeightRequest="10"
                               MaxLength="14"/>

                        <Entry Placeholder="Alignment"
                               Grid.Row="1"
                               Grid.Column="2"
                               FontSize="18"
                               TextColor="Black"
                               WidthRequest="175"
                               HorizontalOptions="Start"
                               FontAttributes="Bold"
                               HeightRequest="10"
                               MaxLength="14"/>

                        <Entry Placeholder="Background"
                               Grid.Row="1"
                               Grid.Column="3"
                               FontSize="18"
                               TextColor="Black"
                               WidthRequest="175"
                               HorizontalOptions="Start"
                               FontAttributes="Bold"
                               HeightRequest="10"
                               MaxLength="14"/>

                    </Grid>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">

                <VerticalStackLayout Grid.Column="0" WidthRequest="80" Spacing="10">
                    <Label Text="Attributes" TextColor="Black" HorizontalOptions="Center" FontAttributes="Bold"/>
                    <BoxView HeightRequest="1" Color="Black"/>
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="FOR" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>

                        <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                            <VerticalStackLayout VerticalOptions="Center">

                                <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>

                                <BoxView HeightRequest="1" Color="Black" WidthRequest="40"/>

                                <Label Text="+16" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="DEX" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>

                        <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                            <VerticalStackLayout VerticalOptions="Center">

                                <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>

                                <BoxView HeightRequest="1" Color="Black" WidthRequest="40"/>

                                <Label Text="+16" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="CON" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>

                        <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                            <VerticalStackLayout VerticalOptions="Center">

                                <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>

                                <BoxView HeightRequest="1" Color="Black" WidthRequest="40"/>

                                <Label Text="+16" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="INT" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>

                        <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                            <VerticalStackLayout VerticalOptions="Center">

                                <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                
                                <BoxView HeightRequest="1" Color="Black" WidthRequest="40"/>

                                <Label Text="+16" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="WIS" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>

                        <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                            <VerticalStackLayout VerticalOptions="Center">

                                <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>

                                <BoxView HeightRequest="1" Color="Black" WidthRequest="40"/>

                                <Label Text="+16" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="CHA" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>

                        <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                            <VerticalStackLayout VerticalOptions="Center">

                                <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>

                                <BoxView HeightRequest="1" Color="Black" WidthRequest="40"/>


                                <Label Text="+16" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>
                        
                        
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="15">

                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Start" Padding="20">

                        <Button BackgroundColor="White" BorderColor="Black" BorderWidth="2" WidthRequest="10" HeightRequest="10">
                        </Button>
                        <Label Text="Inspiration" TextColor="Black" VerticalOptions="Center" Padding="20"/>

                            <Border StrokeShape="RoundRectangle 5" WidthRequest="70" HeightRequest="70" Padding="5" StrokeThickness="2" Stroke="Black">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Entry Placeholder="30" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black" MaxLength="2" />
                                <Label Text="SPEED" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeShape="Ellipse" WidthRequest="70" HeightRequest="70" Padding="5" StrokeThickness="2" Stroke="Black">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Entry Placeholder="15" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black" MaxLength="2" />
                                <Label Text="CA" FontSize="10" HorizontalOptions="Center" TextColor="Black"/>
                            </VerticalStackLayout>
                        </Border>

                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 10" Padding="10">
                        <VerticalStackLayout>
                            <Label Text="PONTOS DE VIDA ATUAIS" FontSize="10" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <Entry Placeholder="25 / 25" 
                                   HorizontalTextAlignment="Center" 
                                   FontSize="24" 
                                   Keyboard="Numeric"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="1">
                        <Label Text="ATAQUES &amp; CONJURAÇÃO" FontSize="10" HorizontalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>