<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DndCharacterSheet.MainPage"
             BackgroundColor="#f5f4f2">
    <Grid ColumnDefinitions="*" RowDefinitions="*, 100">
        <Grid ColumnDefinitions="*, *" Grid.Row="0">

            <Border Grid.Column="0" 
                        BackgroundColor="#e3e3d1" 
                        Stroke="Black" 
                        StrokeThickness="2" 
                        Margin="10" 
                        StrokeShape="RoundRectangle 10">
                <ContentView>
                    <VerticalStackLayout Padding="20" Spacing="20">
                        <Label Text="CHARACTER BUILDER" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Maroon"/>
                        <BoxView HeightRequest="2" Color="Black"/>
                        <Label Text="Configurações de Criação" FontSize="18" FontAttributes="Bold" TextColor="Black"/>

                        <Button Text="Gerar Atributos" BackgroundColor="#2c3e50" TextColor="White" Margin="0,10"/>
                        <Button Text="Aplicar Bônus" BackgroundColor="#2c3e50" TextColor="White"/>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12">
                            <Picker x:Name="RacaPicker" Title="Selecione sua classe" TitleColor="Black" FontSize="14" TextColor="White" SelectedIndexChanged="OnSelected" BackgroundColor="#2c3e50" HorizontalTextAlignment="Center">
                                <Picker.Items>
                                    <x:String>Humano</x:String>
                                    <x:String>Tiefling</x:String>
                                    <x:String>Tabaxi</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>
                </ContentView>
            </Border>
            <ContentView Grid.Column="1" x:Name="PageContainer">
                
            </ContentView>
        </Grid>
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="End" Grid.Row="1">
            <Border StrokeShape="RoundRectangle 45" BackgroundColor="#292727" WidthRequest="750" HeightRequest="90" HorizontalOptions="Center">

                <HorizontalStackLayout Padding="15, 0, 0, 0">

                    <ImageButton HeightRequest="55" WidthRequest="55" Background="#2c3e50" CornerRadius="27" Source="" Margin="5">
                    </ImageButton>
                    
                    <ImageButton HeightRequest="55" WidthRequest="55" Background="#2c3e50" CornerRadius="27" Source="" Margin="5">
                    </ImageButton>

                    <ImageButton HeightRequest="55" WidthRequest="55" CornerRadius="27" Margin="5" Clicked="ImageButton_Clicked">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#2c3e50" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#344b61" />
                                            <Setter Property="Scale" Value="1.1" />
                                        </VisualState.Setters>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.95" />
                                            <Setter Property="BackgroundColor" Value="#26384a" />
                                        </VisualState.Setters>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </ImageButton>

                    <ImageButton HeightRequest="55" WidthRequest="55" Background="#2c3e50" CornerRadius="27" Source="" Margin="5">
                    </ImageButton>

                </HorizontalStackLayout>

            </Border>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>