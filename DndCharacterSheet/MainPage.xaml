<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DndCharacterSheet.MainPage"
             BackgroundColor="#f5f4f2">
    <Grid ColumnDefinitions="*" RowDefinitions="*, 75">
        <Grid ColumnDefinitions="*, *" Grid.Row="0">

            <Border Grid.Column="0" 
                        BackgroundColor="#e3e3d1" 
                        Stroke="Black" 
                        StrokeThickness="2" 
                        Margin="10" 
                        StrokeShape="RoundRectangle 10">

                <VerticalStackLayout Padding="20" Spacing="20">
                    <Label Text="CHARACTER BUILDER" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Maroon"/>
                    <BoxView HeightRequest="2" Color="Black"/>
                    <Label Text="Configurações de Criação" FontSize="18" FontAttributes="Bold" TextColor="Black"/>

                    <Button Text="Gerar Atributos" BackgroundColor="#2c3e50" TextColor="White" Margin="0,10"/>
                    <Button Text="Aplicar Bônus" BackgroundColor="#2c3e50" TextColor="White"/>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 12">
                        <Picker x:Name="RacaPicker" Title="Selecione sua classe" TitleColor="Black" FontSize="14" TextColor="White" SelectedIndexChanged="OnSelected" BackgroundColor="#2c3e50" HorizontalTextAlignment="Center">
                            <Picker.Items>
                                <x:String>Humano</x:String>
                                <x:String>Tiefling</x:String>
                                <x:String>Tabaxi</x:String>
                            </Picker.Items>
                        </Picker>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <ScrollView Grid.Column="1">
                <VerticalStackLayout Padding="20" Spacing="15">

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10">
                        <Border StrokeShape="RoundRectangle 10" Padding="10" BackgroundColor="White" Stroke="Black" StrokeThickness="2" Grid.Column="0" HeightRequest="80">
                            <Entry Placeholder="Nome do Personagem" FontSize="22" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>
                        </Border>

                        <Border StrokeShape="RoundRectangle 10" Padding="10" BackgroundColor="White" Stroke="Black" StrokeThickness="2" Grid.Column="1">
                            <Grid ColumnDefinitions="*, *, *, *" RowDefinitions="Auto, Auto">
                                <Entry Placeholder="Classe e Nível" Grid.ColumnSpan="4" FontSize="16" FontAttributes="Bold" TextColor="Black"/>
                                <Entry Placeholder="Sub" Grid.Row="1" Grid.Column="0" FontSize="12" TextColor="Black"/>
                                <Entry Placeholder="Race" Grid.Row="1" Grid.Column="1" FontSize="12" TextColor="Black"/>
                                <Entry Placeholder="Alig." Grid.Row="1" Grid.Column="2" FontSize="12" TextColor="Black"/>
                                <Entry Placeholder="Backg." Grid.Row="1" Grid.Column="3" FontSize="12" TextColor="Black"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>


                        <VerticalStackLayout Grid.Column="0" WidthRequest="90" Spacing="10">
                            <Label Text="ATTRIBUTES" TextColor="Black" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <BoxView HeightRequest="1" Color="Black"/>

                            <Label Text="FOR" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black"/>
                            <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                                    <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                    <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                    <Label Text="+3" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="DEX" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black" Margin="0,5,0,0"/>
                            <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                    <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                    <Label Text="+2" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="CON" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black" Margin="0,5,0,0"/>
                            <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                    <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                    <Label Text="+2" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="INT" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black" Margin="0,5,0,0"/>
                            <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                    <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                    <Label Text="+2" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="WIS" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black" Margin="0,5,0,0"/>
                            <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                    <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                    <Label Text="+2" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="CHA" HorizontalOptions="Center" FontSize="10" FontAttributes="Bold" TextColor="Black" Margin="0,5,0,0"/>
                            <Border StrokeShape="RoundRectangle 5" HeightRequest="70" WidthRequest="70" Stroke="Black" StrokeThickness="2">
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Entry MaxLength="2" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
                                    <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                    <Label Text="+2" FontSize="12" HorizontalOptions="Center" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1">
                            <HorizontalStackLayout>

                                <Button BorderColor="Black" BorderWidth="2" Margin="10, 0, 5 , 10" WidthRequest="45" VerticalOptions="Center" HorizontalOptions="Start" BackgroundColor="White">
                                </Button>
                                <Label Text="Inspiration" TextColor="Black" HeightRequest="40" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold">
                                </Label>

                            </HorizontalStackLayout>
                            <HorizontalStackLayout>
                                <Border StrokeShape="Ellipse" Stroke="Black" StrokeThickness="2" WidthRequest="45" HeightRequest="45" HorizontalOptions="Start" Margin="10, 0, 5, 10">
                                    <Entry Placeholder="+4" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" TextColor="Black" MaxLength="2"/>
                                </Border>
                                <Label Text="Proficiency Bonus" TextColor="Black" HeightRequest="40" HorizontalOptions="Center" FontSize="18" FontAttributes="Bold">
                                </Label>
                            </HorizontalStackLayout>

                            <Border StrokeShape="RoundRectangle 5" Padding="0" Stroke="Black" StrokeThickness="2" BackgroundColor="White" WidthRequest="250" HeightRequest="200" HorizontalOptions="Start">
                                <Label Text="SAVING THROWS" TextColor="Black" HeightRequest="40" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold" VerticalOptions="End">
                                </Label>
                            </Border>

                            <Border StrokeShape="RoundRectangle 5" Padding="0" Stroke="Black" StrokeThickness="2" BackgroundColor="White" WidthRequest="250" HeightRequest="400" HorizontalOptions="Start" Margin="0, 10, 0, 0">
                                <Label Text="SKILLS" TextColor="Black" HeightRequest="40" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold" VerticalOptions="End">
                                </Label>
                            </Border>

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="15">

                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Border StrokeShape="Ellipse" WidthRequest="70" HeightRequest="70" Stroke="Black" StrokeThickness="2">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Entry Placeholder="15" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black" MaxLength="2"/>
                                        <BoxView HeightRequest="1" Color="Black" WidthRequest="25" HorizontalOptions="Center"/>
                                        <Label Text="CA" FontSize="8" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border StrokeShape="RoundRectangle 5" WidthRequest="70" HeightRequest="70" Stroke="Black" StrokeThickness="2">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Entry Placeholder="10" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black" MaxLength="2"/>
                                        <BoxView HeightRequest="1" Color="Black" WidthRequest="40" HorizontalOptions="Center"/>
                                        <Label Text="INITIATIVE" FontSize="8" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>

                                <Border StrokeShape="RoundRectangle 5" WidthRequest="70" HeightRequest="70" Stroke="Black" StrokeThickness="2">
                                    <VerticalStackLayout VerticalOptions="Center">                                        
                                        <Entry Placeholder="10" FontSize="18" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black" MaxLength="2"/>
                                        <BoxView HeightRequest="1" Color="Black" WidthRequest="30" HorizontalOptions="Center"/>
                                        <Label Text="SPEED" FontSize="8" HorizontalOptions="Center" TextColor="Black" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </HorizontalStackLayout>

                            <Border StrokeShape="RoundRectangle 10" Padding="10" Stroke="Black" StrokeThickness="2" BackgroundColor="White">
                                <VerticalStackLayout>
                                    <Label Text="PONTOS DE VIDA ATUAIS" FontSize="10" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                                    <Entry Placeholder="25 / 25" HorizontalTextAlignment="Center" FontSize="24" TextColor="Maroon" FontAttributes="Bold"/>
                                    <Label Text="PONTOS DE VIDA TEMPORARIOS" FontSize="10" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                                    <Entry Placeholder="25 / 25" HorizontalTextAlignment="Center" FontSize="24" TextColor="Maroon" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="2" Stroke="Black" BackgroundColor="White" HeightRequest="150">
                                <VerticalStackLayout>
                                    <Label Text="ATAQUES &amp; CONJURAÇÃO" FontSize="10" HorizontalOptions="Center" FontAttributes="Bold" TextColor="Black"/>
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="15">
                            <Border StrokeShape="RoundRectangle 5" Padding="0" Stroke="Black" StrokeThickness="2" BackgroundColor="White" WidthRequest="250" HeightRequest="410" HorizontalOptions="Start" Margin="0, 10, 0, 0">
                                <VerticalStackLayout>
                                    <Label Text="CHARACTERISTICS" TextColor="Black" HeightRequest="40" HorizontalOptions="Center" FontSize="16" FontAttributes="Bold" VerticalOptions="Start" Padding="0, 10, 0, 0">
                                    </Label>
                                    <Border StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="2" Stroke="Black" BackgroundColor="White" HeightRequest="85" WidthRequest="225" Margin="2">
                                        <VerticalStackLayout>
                                            <Label Text="PERSONALITY TRAITS" FontSize="10" HorizontalOptions="Center" VerticalOptions="End" FontAttributes="Bold" TextColor="Black"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="2" Stroke="Black" BackgroundColor="White" HeightRequest="85" WidthRequest="225" Margin="2">
                                        <VerticalStackLayout>
                                            <Label Text="PERSONALITY TRAITS" FontSize="10" HorizontalOptions="Center" VerticalOptions="End" FontAttributes="Bold" TextColor="Black"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="2" Stroke="Black" BackgroundColor="White" HeightRequest="85" WidthRequest="225" Margin="2">
                                        <VerticalStackLayout>
                                            <Label Text="PERSONALITY TRAITS" FontSize="10" HorizontalOptions="Center" VerticalOptions="End" FontAttributes="Bold" TextColor="Black"/>
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border StrokeShape="RoundRectangle 10" Padding="10" StrokeThickness="2" Stroke="Black" BackgroundColor="White" HeightRequest="85" WidthRequest="225" Margin="2">
                                        <VerticalStackLayout>
                                            <Label Text="PERSONALITY TRAITS" FontSize="10" HorizontalOptions="Center" VerticalOptions="End" FontAttributes="Bold" TextColor="Black"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <HorizontalStackLayout Grid.Row="1" BackgroundColor="#1c1b1b">
            <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="15">

                <HorizontalStackLayout Grid.Column="0" Padding="15, 0, 0, 0">
                    <Button HeightRequest="70" Text="Sheets" Background="#292727" TextColor="AntiqueWhite" CornerRadius="6" BorderColor="AntiqueWhite" BorderWidth="1">
                    </Button>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1">
                    <Button WidthRequest="100" HeightRequest="80" Text="Core" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="Bio" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="Spells" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1">
                    </Button>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="2">
                    <Button WidthRequest="100" HeightRequest="80" Text="d4" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="d6" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="d8" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="d10" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="d12" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="d20" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="100" HeightRequest="80" Text="d100" Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="3">
                    <Button WidthRequest="110" HeightRequest="80" Text="Descanso L." Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                    <Button WidthRequest="110" HeightRequest="80" Text="Descanso C." Background="#292727" TextColor="AntiqueWhite" CornerRadius="0" BorderColor="AntiqueWhite" BorderWidth="1" Margin="5">
                    </Button>
                </HorizontalStackLayout>

            </Grid>
            
        </HorizontalStackLayout>
    </Grid>
</ContentPage>